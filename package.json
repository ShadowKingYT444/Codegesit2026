{
  "name": "ride-along",
  "version": "1.0.0",
  "description": "Ride-Along: practice runs for new Jira Service Management agents, built from your own solved tickets.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "build": "npm --prefix static/practice install && npm --prefix static/practice run build",
    "test": "node --test --test-reporter=spec \"test/unit/*.test.js\"",
    "validate": "node scripts/validate-manifest.mjs",
    "sim": "node test/run-sim.mjs",
    "eval:solved": "node test/eval-solved.mjs",
    "eval:pii": "node test/eval-pii.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/events": "^3.0.11",
    "@forge/kvs": "^2.1.3",
    "@forge/llm": "^1.1.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.11"
  }
}
